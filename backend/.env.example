# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# Google Gemini API key. Used twice per analysis: once to plan the search queries and once to judge the evidence.
GEMINI_API_KEY=your_gemini_api_key_here
# TinyFish API key. Used to search the web and to fetch the text of the pages that were found.
TINYFISH_API_KEY=your_tinyfish_api_key_here

# -----------------------------------------------------------------------------
# OPTIONAL: Community Fact-Checks (MongoDB)
# Without MongoDB, claim analysis still works. Only the Community Fact-Checks
# page is disabled and shows an "unavailable" message.
# -----------------------------------------------------------------------------

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=truthlens

# -----------------------------------------------------------------------------
# OPTIONAL: WhatsApp bot (Meta WhatsApp Cloud API)
# -----------------------------------------------------------------------------

# A secret string YOU choose. Paste the same value into Meta's webhook "Verify token" field.
WHATSAPP_VERIFY_TOKEN=
# Meta app dashboard -> App settings -> Basic -> App secret. Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
# WhatsApp -> API Setup -> access token (temporary, or a permanent System User token).
WHATSAPP_ACCESS_TOKEN=
# WhatsApp -> API Setup -> Phone number ID.
WHATSAPP_PHONE_NUMBER_ID=
# Graph API version shown in the sample request on the API Setup page.
WHATSAPP_GRAPH_VERSION=v26.0